# Salin menjadi .env lalu isi. JANGAN commit .env.
ADMIN_USER=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Buat dengan: openssl rand -hex 32
JWT_SECRET=
# true jika diakses lewat HTTPS (disarankan di server)
COOKIE_SECURE=false
TZ=Asia/Jakarta
# Lokasi data di server (rekaman, cache, database). Default ./data. Isi /data jika flashdisk di-mount di /data.
DATA_PATH=./data
SEGMENT_SECONDS=300
# Total masa simpan (lokal + remote)
RETENTION_DAYS=7
# Batas ukuran buffer lokal dalam GB (0 = tanpa batas). Hanya segmen yang sudah terunggah yang dihapus.
MAX_STORAGE_GB=0
# Salinan lokal dipertahankan sekian jam setelah terunggah
LOCAL_BUFFER_HOURS=24
# Tujuan rclone, mis. gdrive:nvr (kosong = tanpa upload). Butuh rclone/rclone.conf
RCLONE_REMOTE=
